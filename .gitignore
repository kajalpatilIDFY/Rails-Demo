# Ignore bundler state
/.bundle
/vendor/bundle/

# Minimal Rails specific artifacts
db/*.sqlite3
/log/*
/tmp/*

# Various artifacts
**.war
*.rbc
*.sassc
.rspec
.redcar/
.sass-cache/
.byebug_history
.foreman
.local_env
.ruby-version

# IDE-specific files (examples, adjust as needed)
.idea/
.vscode/
*.swp
*.swo

# Environment variables and secrets
config/database.yml
config/secrets.yml
config/master.key
config/credentials.yml.enc
.env
.env.*

# Uploaded files and cached data
/public/uploads
/public/assets # If you're precompiling assets and don't want them in Git
/storage/ # For Active Storage

# Test coverage reports
/coverage/

# Node.js artifacts (if using Webpacker/Node dependencies)
/node_modules/
/yarn-error.log
/package-lock.json

# RubyMine-specific files
.idea/
.rakeTasks

# Other temporary or generated files
/public/packs
/public/packs-test
