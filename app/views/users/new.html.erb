<div class="bg-white shadow sm:rounded-lg p-6">
  <h1 class="text-2xl font-semibold mb-4">Create an account</h1>

  <%= form_with model: @user, url: signup_path, local: true do |f| %>
    <%= render "shared/form_errors", object: @user %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autofocus: true, required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password_confirmation, required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Create account", class: "w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-sky-600 hover:bg-sky-700" %>
      </div>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-slate-500">Already have an account? <%= link_to "Login", login_path, class: "text-sky-600 hover:underline" %></p>
</div>
