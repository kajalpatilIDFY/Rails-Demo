<div class="bg-white shadow sm:rounded-lg p-6 max-w-md">
  <h1 class="text-2xl font-semibold mb-4">Log in</h1>

  <%= form_with url: login_path, scope: :session, local: true do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, value: params.dig(:session, :email), required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div>
        <%= f.submit "Login", class: "w-full inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-sky-600 hover:bg-sky-700" %>
      </div>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-slate-500">Don't have an account? <%= link_to "Sign up", signup_path, class: "text-sky-600 hover:underline" %></p>
</div>
