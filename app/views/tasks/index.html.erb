<h1>Your Tasks</h1>

<%= link_to "New Task", new_task_path %>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Due</th>
      <th>Completed</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.due_date || "-" %></td>
        <td><%= task.completed? ? "✔" : "—" %></td>
        <td>
          <%= link_to "Edit", edit_task_path(task) %> |
          <%= link_to "Delete", task_path(task), method: :delete, data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
