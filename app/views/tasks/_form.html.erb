<%= form_with model: @task, local: true do |f| %>
<%= render "shared/form_errors", object: @task %>

  <div class="space-y-4 bg-white p-6 rounded-md shadow sm:rounded-lg">
    <div>
      <%= f.label :title, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :title, required: true, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= f.label :due_date, class: "block text-sm font-medium text-slate-700" %>
        <%= f.date_field :due_date, class: "mt-1 block w-full rounded-md border-slate-200 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      </div>

      <div class="flex items-center gap-2 sm:col-span-2">
        <%= f.check_box :completed, class: "h-4 w-4 text-sky-600 border-slate-300 rounded" %>
        <%= f.label :completed, class: "text-sm text-slate-700" %>
      </div>
    </div>

    <div class="pt-2 flex gap-3">
      <%= f.submit class: "inline-flex items-center px-4 py-2 rounded-md bg-sky-600 text-white hover:bg-sky-700" %>
      <%= link_to "Cancel", tasks_path, class: "inline-flex items-center px-4 py-2 rounded-md border border-slate-200 hover:bg-slate-50" %>
    </div>
  </div>
<% end %>
