<h2>Edit On Artist Here</h2>

<ul>
    <%= form_for @artist do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name, :required => true %><br>

    <%= f.label :age %>
    <%= f.number_field :age, :required => true %><br>

    <%= f.label :experience_level %>
    <%= f.select :experience_level, (1..10) :required => true %>

    <%= f.submit "Update Profile" %>

    <% end %>
</ul>