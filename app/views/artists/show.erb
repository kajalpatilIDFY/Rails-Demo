<h2><%= "#{@artist.name}'s Profile" %></h2>

<label>Name: </label>
<%= @artist.name %> <br>

<label>Age: </label>
<%= @artist.age %> <br>

<label>Experience Level: </label>
<%= @artist.experience_level %> <br>

<label>Here is list of all paintings</label>
    <ul>
        <% @artist.paintings.each do |painting| %>
        <li><%= link_to painting.name, painting %></li>
        <% end %>
    </ul> 

<%= button_to "Click Here to Retire", @artist, method: :delete %>